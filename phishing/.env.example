CHAINABUSE_ALLOW_PARTIAL=False
CHAINABUSE_CHECKPOINT_INTERVAL_PAGES=500
CHAINABUSE_CHECKPOINT_DIR=chainabuse_checkpoints
CHAINABUSE_RESUME=True

REQUEST_TIMEOUT_SECONDS=120

