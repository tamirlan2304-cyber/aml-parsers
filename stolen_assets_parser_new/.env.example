TELEGRAM_INVESTIGATIONS_URL=https://t.me/s/investigations
REQUEST_TIMEOUT_SECONDS=60
TELEGRAM_REQUEST_DELAY_SECONDS=0.25
TELEGRAM_MAX_PAGES=200
TELEGRAM_MAX_RETRIES=3

SLOWMIST_HACKED_URL=https://hacked.slowmist.io/?c=&page=1
SLOWMIST_REQUEST_DELAY_SECONDS=0.5
SLOWMIST_MAX_PAGES=0
SLOWMIST_MAX_RETRIES=4

# Public GitHub source; no GitHub account or browser session is needed.
DEFIHACKLABS_REF=main
DEFIHACKLABS_MAX_RETRIES=3
# Optional offline clone: reads committed HEAD, not uncommitted files.
DEFIHACKLABS_REPO_DIR=
# Separate fixed output key: stolen_assets/defihacklabs.parquet

# All addresses published in SoK bridge tables; all files use the same Git SHA.
SOK_INTEROP_REF=main
SOK_INTEROP_MAX_RETRIES=3
# Separate fixed output key: stolen_assets/sok_interop.parquet

# SolidityScan WordPress API; category and output key are fixed in code.
SOLIDITYSCAN_MAX_RETRIES=3
# Separate fixed output key: stolen_assets/solidityscan_hack_analysis.parquet

AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=replace_me
S3_ENDPOINT_URL=https://replace-me.example
S3_BUCKET=replace_me
S3_KEY=stolen_assets/stolen_assets.parquet
S3_VERIFY_SSL=True
S3_ADDRESSING_STYLE=auto
